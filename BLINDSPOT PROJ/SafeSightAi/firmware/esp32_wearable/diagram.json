{
  "version": 1,
  "author": "K Kishore",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-hc-sr04", "id": "ultrasonic1", "top": -75.3, "left": -186.5, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "buzzer1", "top": -75, "left": 200, "attrs": { "volume": "0.5" } },
    { "type": "chip-l298n", "id": "driver1", "top": 200, "left": -50, "attrs": {} },
    { "type": "wokwi-dc-motor", "id": "motor1", "top": 200, "left": 200, "attrs": { "label": "Motor A" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "ultrasonic1:VCC", "green", [ "h0" ] ],
    [ "esp:GND.2", "ultrasonic1:GND", "black", [ "v0" ] ],
    [ "esp:5", "ultrasonic1:TRIG", "green", [ "h0" ] ],
    [ "ultrasonic1:ECHO", "esp:18", "green", [ "v0" ] ],

    [ "esp:23", "buzzer1:1", "red", [ "h0" ] ],
    [ "esp:GND.1", "buzzer1:2", "black", [ "h0" ] ],

    [ "esp:VIN", "driver1:GND", "black", [ "h0" ] ],
    [ "esp:GND.3", "driver1:GND", "black", [ "h0" ] ],
    [ "esp:19", "driver1:IN1", "blue", [ "h0" ] ],
    [ "esp:21", "driver1:IN2", "blue", [ "h0" ] ],
    [ "esp:22", "driver1:EN A", "purple", [ "h0" ] ],

    [ "driver1:OUT1", "motor1:pos", "red", [ "h0" ] ],
    [ "driver1:OUT2", "motor1:neg", "black", [ "h0" ] ]
  ],
  "dependencies": {
    "chip-l298n": "github:drf5n/Wokwi-Chip-L298N@main"
  }
}