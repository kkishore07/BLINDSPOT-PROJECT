*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Crash Reports & Packages
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Hardware & Firmware Build Artifacts
# ------------------------------------------------------------------------------
**/blindspotai/build/
*.bin
*.elf
*.hex
*.map

# ------------------------------------------------------------------------------
# Runtime Logs & Temp Dumps
# ------------------------------------------------------------------------------
*.log
output/
data/yolo_output.jpg
data/midas_output.jpg
data/midas_output_debug.jpg

# ------------------------------------------------------------------------------
