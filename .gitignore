/Editor/
/Unity Hub/
/construction_worker_in_training.glb
**/.git_backup/

# ------------------------------------------------------------------------------
# Unity Cache & Temporary Folders
# ------------------------------------------------------------------------------
/[Aa]ssets/AssetStoreTools*
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ibrary/
**/[Ll]ogs/
**/[Mm]emoryCaptures/
**/[Oo]bj/
**/[Pr]ojectSettings/ProjectVersion.txt.bak
**/[Tt]emp/
**/[Uu]ser[Ss]ettings/

# ------------------------------------------------------------------------------
# IDE & Autogenerated Project Files
# ------------------------------------------------------------------------------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

